{
  "name": "orbital-command",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ORBITAL COMMAND — isometric colony builder with a Rust simulation core",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "npm run wasm && vite",
    "build": "npm run wasm && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview --port 4173",
    "ci": "node scripts/ci.mjs",
    "shot": "node scripts/screenshot.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
